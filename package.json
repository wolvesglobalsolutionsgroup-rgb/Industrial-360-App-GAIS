{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "NODE_OPTIONS=--max-old-space-size=2048 vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:unit": "vitest run src",
    "test:domain": "vitest run tests/domain",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run tests/rules\"",
    "test:storage-rules": "firebase emulators:exec --only storage \"vitest run tests/storage\"",
    "test:all": "npm run test:unit && npm run test:domain && npm run test:rules && npm run test:storage-rules",
    "qa:manifest": "tsx scripts/qa/generateManifest.ts",
    "qa:dry-run": "tsx scripts/qa/seedQaDataset.ts --dry-run",
    "qa:seed": "tsx scripts/qa/seedQaDataset.ts --apply",
    "qa:reset": "tsx scripts/qa/seedQaDataset.ts --reset",
    "test:qa": "firebase emulators:exec --only firestore \"vitest run tests/qa\"",
    "audit:no-hardcoded-tenant": "node scripts/auditNoHardcodedTenant.js",
    "audit:tenant-isolation": "node scripts/auditTenantIsolation.mjs",
    "audit:firestore-guardrails": "node scripts/auditFirestoreGuardrails.mjs",
    "audit:bundle-budget": "node scripts/validateBundleBudget.mjs",
    "audit:workflow-conformance": "npx tsx scripts/auditWorkflowConformance.ts",
    "audit:industrial-data": "npx tsx scripts/auditNoHardcodedIndustrialData.ts",
    "audit:gates": "npm run audit:no-hardcoded-tenant && npm run audit:tenant-isolation && npm run audit:firestore-guardrails && npm run audit:workflow-conformance && npm run audit:industrial-data && npm run audit:bundle-budget",
    "analyze": "node scripts/analyzeBundle.mjs",
    "validate:sprint-ledger": "node scripts/validateSprintLedger.mjs",
    "lint": "tsc --noEmit --project tsconfig.json",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^1.29.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@sentry/react": "^10.69.0",
    "@tailwindcss/vite": "^4.1.14",
    "@turf/turf": "^7.3.5",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet-draw": "^1.0.13",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dexie": "^4.4.4",
    "docx": "^9.7.1",
    "dompurify": "^3.4.13",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.1",
    "fast-xml-parser": "^5.5.10",
    "firebase": "^12.11.0",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-firebase-hooks": "^5.1.1",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.8.1",
    "resend": "^6.18.0",
    "tailwind-merge": "^3.5.0",
    "three": "^0.183.2",
    "tokml": "0.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/exceljs": "^1.3.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/three": "^0.183.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.1",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.18.2",
    "react-router-dom": "^7.18.2",
    "minimist": "^1.2.8",
    "minimatch": "^9.0.5",
    "uuid": "^11.1.1",
    "image-size": "npm:isomorphic-image-size@1.0.6",
    "nanoid": "^5.1.6"
  }
}
